<?xml version="1.0"?>
<project name="serverlog-plugin" basedir="." default="build">

	<!-- Load shared plugin properties -->
	<dirname property="plugin.dir" file="${ant.file.serverlog-plugin}"/>
	<property file="${plugin.dir}/../build.properties" />

	<!-- Local properties -->
	<property name="classes" value="${basedir}/classes" />
	<property name="src.plugin" value="${server.src}/com/mirth/connect/plugins/serverlog" />
	<property name="lib" value="${server.lib.extensions}/serverlog" />
	<property name="dist" value="${server.extensions}/serverlog" />

	<path id="classpath">
		<fileset dir="${server.lib}" includes="**/*.jar" />
		<pathelement location="${server.classes}" />
	</path>

	<target name="clean">
		<delete dir="${classes}" />
	</target>

	<target name="init">
		<mkdir dir="${classes}" />
		<mkdir dir="${dist}" />
	</target>

	<target name="compile" depends="init">
		<javac srcdir="${server.src}" destdir="${classes}" debug="on" includeAntRuntime="false">
			<include name="com/mirth/connect/plugins/serverlog/" />
			<classpath refid="classpath" />
		</javac>
	</target>

	<target name="build" depends="compile">
		<!-- Copy plugin metadata XML files -->
		<copy todir="${dist}">
			<fileset dir="${src.plugin}">
				<include name="*.xml" />
			</fileset>
		</copy>

		<!-- Copy extension libraries -->
		<copy todir="${dist}/lib" failonerror="false" quiet="true">
			<fileset dir="${lib}" />
		</copy>

		<!-- Create shared jar (classes needed by client) -->
		<jar destfile="${dist}/serverlog-shared.jar" basedir="${classes}">
			<include name="com/mirth/connect/plugins/serverlog/ServerLogItem.class" />
			<include name="com/mirth/connect/plugins/serverlog/ServerLogServletInterface.class" />
		</jar>

		<!-- Create server jar -->
		<jar destfile="${dist}/serverlog-server.jar" basedir="${classes}">
			<include name="com/mirth/connect/plugins/serverlog/**" />
			<exclude name="com/mirth/connect/plugins/serverlog/ServerLogItem.class" />
			<exclude name="com/mirth/connect/plugins/serverlog/ServerLogServletInterface.class" />
		</jar>
	</target>

	<target name="create-zip">
		<zip destfile="${server.dist.extensions}/serverlog-${version}.zip" basedir="${server.extensions}" includes="serverlog/" />
	</target>

</project>
