<?xml version="1.0"?>
<project name="datatype-dicom" basedir="." default="build">

	<dirname property="plugin.dir" file="${ant.file.datatype-dicom}/.."/>
	<property file="${plugin.dir}/../build.properties" />

	<!-- Local properties -->
	<property name="shared.classes" value="${basedir}/shared/classes" />
	<property name="server.classes.local" value="${basedir}/server/classes" />
	<property name="client.classes.local" value="${basedir}/client/classes" />
	<property name="src.shared" value="${basedir}/shared/src" />
	<property name="src.server" value="${basedir}/server/src" />
	<property name="src.client" value="${basedir}/client/src" />
	<property name="dist" value="${server.extensions}/datatype-dicom" />

	<!-- Classes from connector-dicom (already compiled) -->
	<property name="dicom.shared.classes" value="${plugin.dir}/connector-dicom/shared/classes" />
	<property name="dicom.server.classes" value="${plugin.dir}/connector-dicom/server/classes" />
	<property name="dicom.lib" value="${plugin.dir}/connector-dicom/server/lib" />

	<path id="classpath">
		<fileset dir="${server.lib}" includes="**/*.jar" />
		<fileset dir="${dicom.lib}" includes="**/*.jar" />
		<pathelement location="${server.classes}" />
		<pathelement location="${dicom.shared.classes}" />
		<pathelement location="${dicom.server.classes}" />
	</path>

	<path id="classpath.client">
		<fileset dir="${client.lib}" includes="**/*.jar" />
		<pathelement location="${client.classes}" />
		<pathelement location="${dicom.shared.classes}" />
	</path>

	<target name="clean">
		<delete dir="${shared.classes}" />
		<delete dir="${server.classes.local}" />
		<delete dir="${client.classes.local}" />
	</target>

	<target name="compile">
		<mkdir dir="${shared.classes}" />
		<javac srcdir="${src.shared}" destdir="${shared.classes}" debug="on" includeAntRuntime="false">
			<classpath refid="classpath" />
		</javac>

		<mkdir dir="${server.classes.local}" />
		<javac srcdir="${src.server}" destdir="${server.classes.local}" debug="on" includeAntRuntime="false">
			<classpath refid="classpath" />
			<classpath location="${shared.classes}" />
		</javac>

		<mkdir dir="${client.classes.local}" />
		<javac srcdir="${src.client}" destdir="${client.classes.local}" debug="on" includeAntRuntime="false">
			<classpath refid="classpath.client" />
			<classpath location="${shared.classes}" />
		</javac>
	</target>

	<target name="build" depends="compile">
		<mkdir dir="${dist}" />
		<copy file="${src.server}/plugin.xml" todir="${dist}" />

		<jar destfile="${dist}/datatype-dicom-shared.jar" basedir="${shared.classes}" />
		<jar destfile="${dist}/datatype-dicom-server.jar" basedir="${server.classes.local}" />
		<jar destfile="${dist}/datatype-dicom-client.jar" basedir="${client.classes.local}" />
	</target>

	<target name="create-zip">
		<zip destfile="${server.dist.extensions}/datatype-dicom-${version}.zip" basedir="${server.extensions}" includes="datatype-dicom/**/*" />
	</target>

</project>
