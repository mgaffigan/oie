<?xml version="1.0"?>
<project name="imageviewer" basedir="." default="build">

	<dirname property="plugin.dir" file="${ant.file.imageviewer}"/>
	<property file="${plugin.dir}/../build.properties" />

	<property name="src" value="${basedir}/src" />
	<property name="dist" value="${server.extensions}/imageviewer" />

	<target name="clean">
	</target>

	<target name="build">
		<mkdir dir="${dist}" />
		<copy todir="${dist}" file="${src}/plugin.xml" />
	</target>

	<target name="create-zip">
		<zip destfile="${server.dist.extensions}/imageviewer-${version}.zip" basedir="${server.extensions}" includes="imageviewer/**/*" />
	</target>

</project>
