<?xml version="1.0"?>
<project name="js-connector" basedir="." default="build">

	<dirname property="plugin.dir" file="${ant.file.js-connector}"/>
	<property file="${plugin.dir}/../build.properties" />

	<property name="src" value="${basedir}/src" />
	<property name="classes" value="${basedir}/classes" />
	<property name="dist" value="${server.extensions}/js" />

	<path id="classpath">
		<fileset dir="${server.lib}" includes="**/*.jar" />
		<pathelement location="${server.classes}" />
	</path>

	<target name="clean">
		<delete dir="${classes}" />
	</target>

	<target name="compile">
		<mkdir dir="${classes}" />
		<javac srcdir="${src}" destdir="${classes}" debug="on" includeAntRuntime="false">
			<classpath refid="classpath" />
		</javac>
	</target>

	<target name="build" depends="compile">
		<mkdir dir="${dist}" />
		<copy todir="${dist}" file="${src}/source.xml" />
		<copy todir="${dist}" file="${src}/destination.xml" />
		<jar destfile="${dist}/js-shared.jar" basedir="${classes}">
			<include name="com/mirth/connect/connectors/js/JavaScriptReceiverProperties.class" />
			<include name="com/mirth/connect/connectors/js/JavaScriptDispatcherProperties.class" />
		</jar>
		<jar destfile="${dist}/js-server.jar" basedir="${classes}">
			<include name="com/mirth/connect/connectors/js/" />
			<exclude name="com/mirth/connect/connectors/js/JavaScriptReceiverProperties.class" />
			<exclude name="com/mirth/connect/connectors/js/JavaScriptDispatcherProperties.class" />
		</jar>
	</target>

	<target name="create-zip">
		<zip destfile="${server.dist.extensions}/js-${version}.zip" basedir="${server.extensions}" includes="js/" />
	</target>

</project>
