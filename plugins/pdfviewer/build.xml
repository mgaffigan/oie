<?xml version="1.0"?>
<project name="pdfviewer" basedir="." default="build">

	<!-- Load shared plugin properties -->
	<dirname property="plugin.dir" file="${ant.file.pdfviewer}"/>
	<property file="${plugin.dir}/../build.properties" />

	<!-- Local properties -->
	<property name="src.plugin" value="${server.src}/com/mirth/connect/plugins/pdfviewer" />
	<property name="lib" value="${server.lib.extensions}/pdfviewer" />
	<property name="dist" value="${server.extensions}/pdfviewer" />

	<target name="clean">
		<!-- No compiled classes to clean -->
	</target>

	<target name="init">
		<mkdir dir="${dist}" />
	</target>

	<target name="build" depends="init">
		<!-- Copy plugin metadata XML files -->
		<copy todir="${dist}">
			<fileset dir="${src.plugin}">
				<include name="*.xml" />
			</fileset>
		</copy>

		<!-- Copy extension libraries -->
		<copy todir="${dist}/lib" failonerror="false" quiet="true">
			<fileset dir="${lib}" />
		</copy>
	</target>

	<target name="create-zip">
		<zip destfile="${server.dist.extensions}/pdfviewer-${version}.zip" basedir="${server.extensions}" includes="pdfviewer/**/*" />
	</target>

</project>
