<?xml version="1.0"?>
<project name="mapper-plugin" basedir="." default="build">

	<dirname property="plugin.dir" file="${ant.file.mapper-plugin}"/>
	<property file="${plugin.dir}/../build.properties" />

	<property name="src" value="${basedir}/src" />
	<property name="classes" value="${basedir}/classes" />
	<property name="dist" value="${server.extensions}/mapper" />

	<path id="classpath">
		<fileset dir="${server.lib}" includes="**/*.jar" />
		<pathelement location="${server.classes}" />
	</path>

	<target name="clean">
		<delete dir="${classes}" />
	</target>

	<target name="compile">
		<mkdir dir="${classes}" />
		<javac srcdir="${src}" destdir="${classes}" debug="on" includeAntRuntime="false">
			<classpath refid="classpath" />
		</javac>
	</target>

	<target name="build" depends="compile">
		<mkdir dir="${dist}" />
		<copy todir="${dist}" file="${src}/plugin.xml" />
		<jar destfile="${dist}/mapper-shared.jar" basedir="${classes}" />
	</target>

	<target name="create-zip">
		<zip destfile="${server.dist.extensions}/mapper-${version}.zip" basedir="${server.extensions}" includes="mapper/" />
	</target>

</project>
