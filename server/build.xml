		<!-- copy lib -->
		<copy todir="${setup.server.lib}">
			<fileset dir="${lib}">
				<exclude name="ant/**" />
				<exclude name="extensions/**" />
			</fileset>
		</copy>

		<!-- copy conf files -->
		<copy todir="${setup.conf}">
			<fileset dir="${conf}" />
		</copy>

		<!-- copy public html files -->
