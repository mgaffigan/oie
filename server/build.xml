		</replace>
		
		<!-- copy Swagger UI files -->
		<copy todir="${setup.public_api_html}">
			<fileset dir="${public_api_html}">
				<exclude name="Thumbs.db" />
			</fileset>
		</copy>

		<!-- copy extensions files -->
