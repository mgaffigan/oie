		</copy>
		<copy todir="${connectors.vm}/lib" failonerror="false" quiet="true">
			<fileset dir="${lib.extensions}/vm" />
		</copy>
		<jar destfile="${connectors.vm}/vm-shared.jar" basedir="${classes.plugins}">
			<include name="com/mirth/connect/connectors/vm/VmReceiverProperties.class" />
