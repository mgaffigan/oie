			</fileset>
		</jar>

		<!-- connectors.smtp -->
		<mkdir dir="${connectors.smtp}" />
		<copy todir="${connectors.smtp}">
			<fileset dir="${src}/com/mirth/connect/connectors/smtp">
				<include name="*.xml" />
			</fileset>
		</copy>
		<copy todir="${connectors.smtp}/lib" failonerror="false" quiet="true">
			<fileset dir="${lib.extensions}/smtp" />
